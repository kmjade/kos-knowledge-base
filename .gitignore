# gitignore template for LangChain products, e.g., LangGraph, LangSmith
# website: https://www.langchain.com/
# website: https://www.langchain.com/langgraph

# LangGraph
.langgraph_api/
# Obsidian
.obsidian/
# PARA - 4 Archives (archive directory, excluded from git)
4 Archives/
# Periodic notes (excluded from git)
Periodic/
# OS files
Thumbs.db
Desktop.ini
.DS_Store
# IDE / editor
.vscode/
.idea/
# Session metadata (transient, auto-generated by hooks)
.vault-meta/
# Personal finance data (privacy)
2 Areas/生活/个人财务/数据/
# Business data (privacy)
2 Areas/工作/企业管理/数据/
# Learning data (privacy)
2 Areas/学习/数据/
# Python cache
__pycache__/

# Canvas media assets (binary files, excluded from git)
_attachments/media/
# Architecture decisions and design (private — vault internal design logic)
_meta/architecture/
# AI runtime state (session logs, global context — privacy)
_meta/ai/memory/
# Operation logs and reports (file paths, AI behavior patterns — privacy)
_meta/system/logs/
# Gemini Scribe plugin data (transient, auto-generated)
.gemini-scribe/
# Temp working files (transient, debugging artifacts)
_temp/