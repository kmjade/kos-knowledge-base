# gitignore template for LangChain products, e.g., LangGraph, LangSmith
# website: https://www.langchain.com/
# website: https://www.langchain.com/langgraph

# LangGraph
.langgraph_api/

# Obsidian
.obsidian/

# PARA - 4 Archives (archive directory, excluded from git)
4 Archives/

# Periodic notes (excluded from git)
Periodic/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# IDE / editor
.vscode/
.idea/

# Session metadata (transient, auto-generated by hooks)
.vault-meta/

# Python cache
__pycache__/

# ======== Privacy Protection ========

# Personal finance actual data (not the templates/classification structure)
2 Areas/生活/个人财务/数据/

# Business actual data (not the templates/classification structure)
2 Areas/工作/企业管理/数据/

# Learning actual data (not the templates/classification structure)
2 Areas/学习/数据/

# Weekly journals and logs (contain personal activity records)
2 Areas/**/日志/

# AI operation logs (file paths, AI behavior patterns)
_meta/system/logs/

# AI runtime state (session logs, global context)
_meta/ai/memory/

# Architecture decisions and design (vault internal design logic)
_meta/architecture/

# Canvas media assets (binary files)
_attachments/media/

# Gemini Scribe plugin data (transient, auto-generated)
.gemini-scribe/

# Temp working files (transient, debugging artifacts)
_temp/

# Trading system data (contains personal contact info)
3 Resources/交易系统/
